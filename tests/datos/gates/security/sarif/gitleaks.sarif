{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "v8.0.0",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "generic-api-key",
              "shortDescription": { "text": "Detected a Generic API Key, potentially exposing access to various services and sensitive operations." }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "generic-api-key",
          "message": { "text": "generic-api-key has detected secret for file services/usuarios/src/config.ts." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "services\\usuarios\\src\\config.ts" },
                "region": {
                  "startLine": 5,
                  "startColumn": 22,
                  "endLine": 5,
                  "endColumn": 58,
                  "snippet": { "text": "REDACTED" }
                }
              }
            }
          ],
          "partialFingerprints": {
            "commitSha": "0000000000000000000000000000000000000000",
            "email": "",
            "author": "",
            "date": "",
            "commitMessage": ""
          },
          "properties": { "tags": [] }
        }
      ]
    }
  ]
}
