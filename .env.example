# Servicios de desarrollo (docker-compose.dev.yml)
NEO4J_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
# Puerto local de Keycloak (el emisor de los tokens lo incluye) y contraseña del usuario de prueba "ana"
KEYCLOAK_PORT=8081
KEYCLOAK_PRUEBA_PASSWORD=
USUARIOS_DB_PASSWORD=
USUARIOS_DB_PORT=5433
# Solo para la prueba comparativa de bases de datos (evaluation/benchmark_bd)
BENCHMARK_DB_PASSWORD=
BENCHMARK_DB_PORT=5434

# Motor del framework
# Proveedor de LLM: gemini, groq, claude, openrouter u ollama
LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# OpenRouter: una clave para muchos modelos; los «:free» son gratis (20 por minuto y 50 al día,
# o 1000 al día con 10 USD de créditos comprados). Modelos vacíos: los del adaptador.
OPENROUTER_API_KEY=
OPENROUTER_MODELO_RAPIDO=
OPENROUTER_MODELO_RAZONAMIENTO=
OLLAMA_HOST=http://localhost:11434
# Opcionales: si se dejan vacíos se usan los modelos por defecto del proveedor
LLM_MODELO_RAPIDO=
LLM_MODELO_RAZONAMIENTO=
# Respaldo si el principal se queda sin cuota o no responde, en orden (p. ej.
# gemini,openrouter,claude). Un respaldo sin su clave no entra en la cadena: claude (de pago) solo
# se usa si hay ANTHROPIC_API_KEY. Vacío: sin respaldo. Ver orchestrator/llm/README.md
LLM_RESPALDO=
# Caché de respuestas en .cache/llm: repetir un documento no gasta cuota (true o false)
LLM_CACHE=true
# Esfuerzo de razonamiento de gpt-oss en Groq: low, medium o high. Vacío: el de Groq.
# low gasta un tercio menos de tokens, pero bajó el F1 de etiquetas de 0,76 a 0,65.
LLM_ESFUERZO_RAZONAMIENTO=
# Modelo de las pruebas Jest de la fase 3: razonamiento (por defecto, el de la evaluación) o
# rapido, que gasta muchos menos tokens de la cuota pero cambia los resultados.
LLM_NIVEL_PRUEBAS=
# Opcional: modelo local de embeddings (por defecto, paraphrase-multilingual-MiniLM-L12-v2)
EMBEDDINGS_MODELO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEO4J_URI=bolt://localhost:7687