# Servicios de desarrollo (docker-compose.dev.yml)
NEO4J_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
# Puerto local de Keycloak (el emisor de los tokens lo incluye) y contraseña del usuario de prueba "ana"
KEYCLOAK_PORT=8081
KEYCLOAK_PRUEBA_PASSWORD=
USUARIOS_DB_PASSWORD=
USUARIOS_DB_PORT=5433
# Solo para la prueba comparativa de bases de datos (evaluation/benchmark_bd)
BENCHMARK_DB_PASSWORD=
BENCHMARK_DB_PORT=5434

# Motor del framework
# Proveedor de LLM: gemini, groq, claude u ollama
LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Opcionales: si se dejan vacíos se usan los modelos por defecto del proveedor
LLM_MODELO_RAPIDO=
LLM_MODELO_RAZONAMIENTO=
# Opcional: modelo local de embeddings (por defecto, paraphrase-multilingual-MiniLM-L12-v2)
EMBEDDINGS_MODELO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEO4J_URI=bolt://localhost:7687