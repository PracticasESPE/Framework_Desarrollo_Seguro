# Copia este archivo como .env y cambia la contraseña. El .env no se sube al repositorio.
DATABASE_URL=postgresql://{{ servicio }}:CAMBIAR@localhost:5432/{{ base_datos }}
PORT={{ puerto }}
# Keycloak: sin emisor y audiencia el servicio no arranca. El emisor usa el puerto de
# KEYCLOAK_PORT del .env de la raíz; la audiencia la añade un mapper del cliente en el realm.
KEYCLOAK_ISSUER=http://localhost:8081/realms/framework
KEYCLOAK_AUDIENCE={{ servicio }}-api
# Opcional: dirección de las claves públicas si no es la estándar del emisor.
# KEYCLOAK_JWKS_URI=http://localhost:8081/realms/framework/protocol/openid-connect/certs
