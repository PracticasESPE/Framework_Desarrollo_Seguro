{%- set fechas = entidad.campos | selectattr('tipo', 'in', ['fecha', 'fecha_hora']) | list -%}
{%- macro dato(c, origen) -%}
{%- if c.tipo in ['fecha', 'fecha_hora'] -%}aFecha({{ origen }}.{{ c.propiedad }})
{%- else -%}{{ origen }}.{{ c.propiedad }}
{%- endif -%}
{%- endmacro -%}
{%- macro respuesta(c) -%}
{%- set nulo = '' if c.requerido else '?' -%}
{%- if c.tipo == 'decimal' -%}fila.{{ c.propiedad }}{{ nulo }}.toNumber()
{%- elif c.tipo == 'fecha' -%}fila.{{ c.propiedad }}{{ nulo }}.toISOString().slice(0, 10)
{%- elif c.tipo == 'fecha_hora' -%}fila.{{ c.propiedad }}{{ nulo }}.toISOString()
{%- elif c.requerido -%}fila.{{ c.propiedad }}
{%- else -%}fila.{{ c.propiedad }} ?? undefined
{%- endif -%}
{%- endmacro -%}
import {
  BadRequestException,
  ConflictException,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
{%- if fechas %}
import { aFecha } from './comun/conversion';
{%- endif %}
import {
  esRegistroInexistente,
  esRelacionRota,
  esValorRepetido,
} from './comun/errores-prisma';
import { PaginacionDto } from './comun/paginacion.dto';
import { Actualizar{{ entidad.clase }}Dto } from './dto/actualizar-{{ entidad.archivo }}.dto';
import { Crear{{ entidad.clase }}Dto } from './dto/crear-{{ entidad.archivo }}.dto';
import { {{ entidad.clase }}PaginaDto } from './dto/{{ entidad.archivo }}-pagina.dto';
import { {{ entidad.clase }}RespuestaDto } from './dto/{{ entidad.archivo }}-respuesta.dto';
import type { {{ entidad.clase }} } from './generated/prisma/client';
import { PrismaService } from './prisma.service';

/** {{ entidad.clase }} tal como la devuelve la API: sin null y con fechas y decimales en JSON. */
function aRespuesta(fila: {{ entidad.clase }}): {{ entidad.clase }}RespuestaDto {
  return {
    id: fila.id,
{%- for c in entidad.campos %}
    {{ c.propiedad }}: {{ respuesta(c) }},
{%- endfor %}
    creadoEn: fila.creadoEn.toISOString(),
    actualizadoEn: fila.actualizadoEn.toISOString(),
  };
}

/**
 * Operaciones de {{ entidad.clase }}. El acceso a la base y el manejo de errores los genera la
 * plantilla; las reglas de negocio van en el bloque marcado al final de la clase.
 */
@Injectable()
export class {{ entidad.clase }}Service {
  constructor(private readonly prisma: PrismaService) {}

  async crear(datos: Crear{{ entidad.clase }}Dto): Promise<{{ entidad.clase }}RespuestaDto> {
    await this.reglasAlCrear(datos);
    try {
      const fila = await this.prisma.{{ entidad.propiedad }}.create({
        data: {
{%- for c in entidad.campos %}
          {{ c.propiedad }}: {{ dato(c, 'datos') }},
{%- endfor %}
        },
      });
      return aRespuesta(fila);
    } catch (error) {
      throw this.traducirError(error, 'guardar');
    }
  }

  async listar({ pagina, tamano }: PaginacionDto): Promise<{{ entidad.clase }}PaginaDto> {
    const [total, filas] = await this.prisma.$transaction([
      this.prisma.{{ entidad.propiedad }}.count(),
      this.prisma.{{ entidad.propiedad }}.findMany({
        // Orden estable: dos páginas seguidas nunca repiten ni saltan un registro.
        orderBy: [{ creadoEn: 'asc' }, { id: 'asc' }],
        skip: (pagina - 1) * tamano,
        take: tamano,
      }),
    ]);
    return { elementos: filas.map(aRespuesta), total, pagina, tamano };
  }

  async obtener(id: string): Promise<{{ entidad.clase }}RespuestaDto> {
    return aRespuesta(await this.buscar(id));
  }

  async actualizar(
    id: string,
    cambios: Actualizar{{ entidad.clase }}Dto,
  ): Promise<{{ entidad.clase }}RespuestaDto> {
    const actual = await this.buscar(id);
    await this.reglasAlActualizar(actual, cambios);
    try {
      const fila = await this.prisma.{{ entidad.propiedad }}.update({
        where: { id },
        data: {
{%- for c in entidad.campos %}
          {{ c.propiedad }}: {{ dato(c, 'cambios') }},
{%- endfor %}
        },
      });
      return aRespuesta(fila);
    } catch (error) {
      throw this.traducirError(error, 'guardar');
    }
  }

  async eliminar(id: string): Promise<void> {
    const actual = await this.buscar(id);
    await this.reglasAlEliminar(actual);
    try {
      await this.prisma.{{ entidad.propiedad }}.delete({ where: { id } });
    } catch (error) {
      throw this.traducirError(error, 'eliminar');
    }
  }

  private async buscar(id: string): Promise<{{ entidad.clase }}> {
    const fila = await this.prisma.{{ entidad.propiedad }}.findUnique({ where: { id } });
    if (!fila) {
      throw new NotFoundException('No existe ningún registro de {{ entidad.clase }} con ese id');
    }
    return fila;
  }

  /** Los errores de datos de Prisma son 400, 404 o 409, nunca 500. */
  private traducirError(error: unknown, operacion: 'guardar' | 'eliminar'): unknown {
    if (esValorRepetido(error)) {
      return new ConflictException('Ya existe un registro de {{ entidad.clase }} con ese valor único');
    }
    if (esRegistroInexistente(error)) {
      return new NotFoundException('No existe ningún registro de {{ entidad.clase }} con ese id');
    }
    if (esRelacionRota(error)) {
      return operacion === 'eliminar'
        ? new ConflictException('Otros registros dependen de este {{ entidad.clase }}: no se puede eliminar')
        : new BadRequestException('Un identificador de otra entidad no corresponde a ningún registro');
    }
    return error;
  }

  // @framework:logica-negocio:inicio {{ entidad.nombre }}
  // Punto de extensión: reglas de negocio de {{ entidad.clase }}. Lo completa el LLM (fase 3, #64);
  // el resto del archivo lo genera la plantilla y no se modifica. Cada método recibe datos ya
  // validados por el DTO y lanza BadRequestException, ConflictException o NotFoundException (ya
  // importadas) si la operación incumple una regla. Puede consultar la base con this.prisma. Sin
  // reglas, la operación sigue tal cual.

  protected reglasAlCrear(datos: Crear{{ entidad.clase }}Dto): Promise<void> {
    void datos;
    return Promise.resolve();
  }

  protected reglasAlActualizar(
    actual: {{ entidad.clase }},
    cambios: Actualizar{{ entidad.clase }}Dto,
  ): Promise<void> {
    void actual;
    void cambios;
    return Promise.resolve();
  }

  protected reglasAlEliminar(actual: {{ entidad.clase }}): Promise<void> {
    void actual;
    return Promise.resolve();
  }
  // @framework:logica-negocio:fin {{ entidad.nombre }}
}
